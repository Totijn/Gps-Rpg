{
  "name": "gps-mmo-rpg-root",
  "private": true,
  "main": "electron-main.js",
  "scripts": {
    "install:all": "bun install && cd client && bun install",
    "build": "cd client && bun run build",
    "compile": "bun build server/index.ts --compile --outfile game-server",
    "start": "bun run start.ts",
    "start:desktop": "electron .",
    "server": "bun run server/index.ts",
    "dist:win": "electron-builder --win",
    "dev": "bun run server/index.ts"
  },
  "build": {
    "appId": "com.gpsmmorpg.app",
    "productName": "GPS MMORPG",
    "files": [
      "dist/**/*",
      "electron-main.js",
      "package.json",
      "server/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "geolib": "^3.3.14",
    "socket.io": "^4.8.3",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "electron-is-dev": "^3.0.1"
  }
}
